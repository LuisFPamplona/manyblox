<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources><clear /><add key="nuget.org" value="https://api.nuget.org/v3/index.json" /></packageSources>
  <packageSourceMapping><packageSource key="nuget.org">
    <package pattern="Microsoft.Web.WebView2" />
    <package pattern="Microsoft.NETCore.App.*" />
    <package pattern="Microsoft.WindowsDesktop.App.*" />
    <package pattern="Microsoft.AspNetCore.App.Runtime.win-x64" />
  </packageSource></packageSourceMapping>
</configuration>
